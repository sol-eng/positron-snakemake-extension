        ],
        "configuration": {
            "type": "object",
            "title": "Snakemake",
            "properties": {
                "snakemake.run.executable": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path to the `snakemake` executable used to run pipelines in Positron. By default it is taken from the active Python interpreter's environment, a `.venv` in the workspace, the `PATH`, or `~/.local/bin`."
                },
                "snakemake.run.cores": {
                    "type": "string",
                    "default": "all",
                    "markdownDescription": "Cores for runs on this machine (`--cores`): a number or `all`."
                },
                "snakemake.run.jobs": {
                    "type": "number",
                    "default": 10,
                    "markdownDescription": "Jobs to run at once when running jobs as Workbench jobs (`--jobs`)."
                },
                "snakemake.run.extraArgs": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Extra arguments added to every Snakemake run started from Positron, e.g. `[\"--show-failed-logs\"]`.",
                    "items": {
                        "type": "string"
                    }
                },
                "snakemake.run.printShellCommands": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Print each job's shell command in the run output (`--printshellcmds`)."
                },
                "snakemake.run.keepScripts": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Keep the scripts Snakemake generates for `script:` rules (`--skip-script-cleanup`), so a job can be debugged in the console afterwards. They are deleted with the run."
                },
                "snakemake.run.launcherCli": {
                    "type": "string",
                    "default": "posit-workbench-smk-launcher",
                    "markdownDescription": "The Posit Workbench launcher CLI, used to list clusters, submit headless runs, and cancel Workbench jobs. Found next to `snakemake` if it is not on the `PATH`."
                },
                "snakemake.run.confirm": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Ask for confirmation before force killing a run, cancelling a job, deleting outputs, or removing a run from the list."
                },
                "snakemake.run.driver": {
                    "type": "string",
                    "default": "auto",
                    "markdownDescription": "Where Snakemake itself runs. As a Workbench Job it keeps running when the session is suspended or stopped; that needs Positron on Posit Workbench and the launcher CLI.",
                    "enum": [
                        "auto",
                        "local",
                        "job"
                    ],
                    "enumDescriptions": [
                        "Offer to run Snakemake as a Workbench Job when Positron runs in Posit Workbench, otherwise run it in this session.",
                        "Always run Snakemake in this session.",
                        "Always run Snakemake as a Workbench Job, without asking."
                    ]
                },
                "snakemake.run.headless.cluster": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Workbench cluster for Snakemake itself when it runs as a Workbench Job. Asked for when empty and there are several."
                },
                "snakemake.run.headless.image": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Container image for Snakemake itself when it runs as a Workbench Job, if the cluster runs containers. Defaults to this session's image. It needs bash and the same Snakemake environment, on shared storage."
                },
                "snakemake.run.headless.cpus": {
                    "type": "number",
                    "default": 1,
                    "markdownDescription": "CPUs for Snakemake itself when it runs as a Workbench Job."
                },
                "snakemake.run.headless.memory": {
                    "type": "number",
                    "default": 2048,
                    "markdownDescription": "Memory in MB for Snakemake itself when it runs as a Workbench Job."
                }
            }
        }
    },
    "devDependencies": {
        "@posit-dev/positron": "^0.2.13",
        "@types/node": "^20.19.43",
        "@types/vscode": "~1.96.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.25.12",
        "js-yaml": "^3.13.1",
        "mermaid": "^12.2.0",
        "mustache": "^3.1.0",
        "typescript": "^5.9.3"
    },
    "main": "dist/extension.js",
    "scripts": {
        "clean": "rm -rf dist syntaxes languages snippets out build-test *.vsix",
        "regex_build": "mkdir -p syntaxes && node src/js/build_regex.js src/keywords.yaml syntaxes/keywords-regex.json",
        "syntax_build": "npm run regex_build && npx mustache syntaxes/keywords-regex.json src/yaml/snakemake.syntax.yaml | npx js-yaml > syntaxes/snakemake.tmLanguage.json",
        "syntax_inject_build": "npm run regex_build && npx mustache syntaxes/keywords-regex.json src/yaml/snakemake-inject.syntax.yaml | npx js-yaml > syntaxes/snakemake-inject.tmLanguage.json",
        "language_build": "mkdir -p languages && npx js-yaml src/yaml/snakemake.language.yaml > languages/snakemake.json",
        "snippets_build": "mkdir -p snippets && npx js-yaml src/yaml/snakemake.snippets.yaml > snippets/snakemake.json",
        "js_build": "node build.mjs",
        "build": "npm run syntax_build && npm run syntax_inject_build && npm run language_build && npm run snippets_build && npm run js_build",
        "watch": "tsc --watch",
        "package": "npm run build && vsce package -o positron-snakemake.vsix",
        "test:unit": "node build-test.mjs && node --test dist/test/snakemake-manager.test.js",
        "check-types": "tsc --noEmit",
        "vscode:prepublish": "npm run build",
        "test:positron": "esbuild src/positron/test/*.test.ts --bundle --platform=node --format=cjs --outdir=build-test --log-level=warning && node --test build-test/*.test.js",
        "test": "npm run test:unit && npm run test:positron"
    },
    "activationEvents": [
        "workspaceContains:**/Snakefile",
        "workspaceContains:**/*.smk"
    ]
}
