{
    "name": "positron-snakemake",
    "displayName": "Positron Snakemake",
    "icon": "logo-snake.png",
    "description": "Snakemake language support, plus running and following Snakemake pipelines in Positron, locally or as Posit Workbench jobs",
    "version": "0.1.0",
    "publisher": "posit",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/sol-eng/positron-snakemake-extension"
    },
    "bugs": {
        "url": "https://github.com/sol-eng/positron-snakemake-extension/issues"
    },
    "engines": {
        "vscode": "^1.96.0",
        "node": ">=18"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configurationDefaults": {
            "files.watcherExclude": {
                "**/.snakemake/**": true
            },
            "search.exclude": {
                "**/.snakemake/**": true
            }
        },
        "languages": [
            {
                "id": "snakemake",
                "aliases": [
                    "Snakemake",
                    "snakemake"
                ],
                "filenames": [
                    "Snakefile"
                ],
                "extensions": [
                    ".smk",
                    ".Snakefile"
                ],
                "configuration": "./languages/snakemake.json",
                "icon": {
                    "light": "./logo-snake.png",
                    "dark": "./logo-snake.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "snakemake",
                "scopeName": "source.python.snakemake",
                "path": "./syntaxes/snakemake.tmLanguage.json"
            },
            {
                "scopeName": "source.python.snakemake.keywords",
                "injectTo": [
                    "source.python.snakemake"
                ],
                "path": "./syntaxes/snakemake-inject.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "snakemake",
                "path": "./snippets/snakemake.json"
            }
        ],
        "commands": [
            {
                "command": "snakemake.positron.runSelection",
                "title": "Run Line or Selection in Console",
                "category": "Snakemake",
                "icon": "$(play)"
            },
            {
                "command": "snakemake.positron.runBlock",
                "title": "Run `run:` Block in Console",
                "category": "Snakemake",
                "icon": "$(run-all)"
            },
            {
                "command": "snakemake.positron.openInDataExplorer",
                "title": "Open in Data Explorer",
                "category": "Snakemake",
                "icon": "$(table)"
            },
            {
                "command": "snakemake.positron.runs.run",
                "title": "Run Pipeline...",
                "category": "Snakemake",
                "icon": "$(play)"
            },
            {
                "command": "snakemake.positron.runs.dryRun",
                "title": "Dry Run Pipeline...",
                "category": "Snakemake",
                "icon": "$(eye)"
            },
            {
                "command": "snakemake.positron.runs.runAgain",
                "title": "Run Again",
                "category": "Snakemake",
                "icon": "$(debug-restart)"
            },
            {
                "command": "snakemake.positron.runs.rerunIncomplete",
                "title": "Run Again, Rerunning Incomplete Jobs",
                "category": "Snakemake",
                "icon": "$(debug-continue)"
            },
            {
                "command": "snakemake.positron.runs.stop",
                "title": "Stop Run",
                "category": "Snakemake",
                "icon": "$(debug-stop)"
            },
            {
                "command": "snakemake.positron.runs.finishJobs",
                "title": "Stop After Running Jobs Finish",
                "category": "Snakemake",
                "icon": "$(debug-pause)"
            },
            {
                "command": "snakemake.positron.runs.kill",
                "title": "Force Kill Run",
                "category": "Snakemake",
                "icon": "$(close)"
            },
            {
                "command": "snakemake.positron.runs.unlock",
                "title": "Unlock Working Directory",
                "category": "Snakemake",
                "icon": "$(unlock)"
            },
            {
                "command": "snakemake.positron.runs.showOutput",
                "title": "Show Run Output",
                "category": "Snakemake",
                "icon": "$(output)"
            },
            {
                "command": "snakemake.positron.runs.openLog",
                "title": "Open Snakemake Log",
                "category": "Snakemake",
                "icon": "$(file)"
            },
            {
                "command": "snakemake.positron.runs.remove",
                "title": "Remove from List",
                "category": "Snakemake",
                "icon": "$(clear-all)"
            },
            {
                "command": "snakemake.positron.runs.delete",
                "title": "Delete Run...",
                "category": "Snakemake",
                "icon": "$(trash)"
            },
            {
                "command": "snakemake.positron.runs.deleteOutput",
                "title": "Delete Workflow Outputs...",
                "category": "Snakemake",
                "icon": "$(trash)"
            },
            {
                "command": "snakemake.positron.runs.openReport",
                "title": "Create and Open Report",
                "category": "Snakemake",
                "icon": "$(graph)"
            },
            {
                "command": "snakemake.positron.runs.openDag",
                "title": "Show Job Graph",
                "category": "Snakemake",
                "icon": "$(type-hierarchy)"
            },
            {
                "command": "snakemake.positron.runs.openRulegraph",
                "title": "Show Rule Graph",
                "category": "Snakemake",
                "icon": "$(type-hierarchy-sub)"
            },
            {
                "command": "snakemake.positron.runs.openSummary",
                "title": "Open Output Summary in Data Explorer",
                "category": "Snakemake",
                "icon": "$(table)"
            },
            {
                "command": "snakemake.positron.runs.lint",
                "title": "Lint Workflow",
                "category": "Snakemake",
                "icon": "$(checklist)"
            },
            {
                "command": "snakemake.positron.runs.cancelJob",
                "title": "Cancel Workbench Job",
                "category": "Snakemake",
                "icon": "$(debug-stop)"
            },
            {
                "command": "snakemake.positron.runs.showJob",
                "title": "Open Job Dashboard",
                "category": "Snakemake",
                "icon": "$(dashboard)"
            },
            {
                "command": "snakemake.positron.runs.debugJob",
                "title": "Debug Job in Console",
                "category": "Snakemake",
                "icon": "$(debug-console)"
            },
            {
                "command": "snakemake.positron.runs.openJobLog",
                "title": "Open Job Log",
                "category": "Snakemake",
                "icon": "$(file)"
            },
            {
                "command": "snakemake.positron.runs.copyJobId",
                "title": "Copy Workbench Job ID",
                "category": "Snakemake",
                "icon": "$(copy)"
            },
            {
                "command": "snakemake.positron.runs.showRunDashboard",
                "title": "Open Run Dashboard",
                "category": "Snakemake",
                "icon": "$(dashboard)"
            },
            {
                "command": "snakemake.positron.runs.refresh",
                "title": "Refresh Pipeline Runs",
                "category": "Snakemake",
                "icon": "$(refresh)"
            },
            {
                "command": "snakemake.positron.runs.diagnostics",
                "title": "Show Run Diagnostics",
                "category": "Snakemake"
            },
            {
                "command": "snakemake.positron.assistant.listRuns",
                "title": "List Pipeline Runs (for the Assistant)",
                "category": "Snakemake",
                "agent": {
                    "description": "List the Snakemake pipeline runs started from Positron in this workspace, most recent first, with their status, Snakefile, targets, times and job totals.",
                    "returns": "JSON array of runs: runName, status, snakefile, targets, dryRun, startedAt, finishedAt, totals.",
                    "readOnly": true
                }
            },
            {
                "command": "snakemake.positron.assistant.runStatus",
                "title": "Show Pipeline Run Status (for the Assistant)",
                "category": "Snakemake",
                "agent": {
                    "description": "Detailed status of one Snakemake pipeline run: per-rule job counts, Snakemake's errors, running jobs with their Posit Workbench job ids, and every failed job with its rule, wildcards, shell command and the end of its log files. Use it to explain why a run failed.",
                    "args": [
                        {
                            "name": "runName",
                            "description": "Name of the run, as listRuns lists it. Defaults to the most recent run.",
                            "required": false,
                            "schema": {
                                "type": "string"
                            }
                        }
                    ],
                    "returns": "JSON object describing the run; failedJobs[].logs[].tail has the end of each log file.",
                    "readOnly": true
                }
            },
            {
                "command": "snakemake.positron.assistant.launchPipeline",
                "title": "Launch Pipeline (for the Assistant)",
                "category": "Snakemake",
                "agent": {
                    "description": "Start a Snakemake pipeline run (or a dry run) that appears in Positron's Pipeline Runs view. Without a profile, its jobs run in the Positron session.",
                    "args": [
                        {
                            "name": "launch",
                            "description": "What to run. Only snakefile is required.",
                            "required": true,
                            "schema": {
                                "type": "object",
                                "required": [
                                    "snakefile"
                                ],
                                "properties": {
                                    "snakefile": {
                                        "type": "string",
                                        "description": "The workflow's Snakefile, absolute or relative to the workspace folder."
                                    },
                                    "targets": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "description": "Target rules or files. Defaults to the workflow's first rule."
                                    },
                                    "profile": {
                                        "type": "string",
                                        "description": "Snakemake profile directory or name."
                                    },
                                    "config": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": [
                                                "string",
                                                "number",
                                                "boolean"
                                            ]
                                        },
                                        "description": "Config overrides, as for --config key=value."
                                    },
                                    "dryRun": {
                                        "type": "boolean",
                                        "description": "Only show what would run (--dry-run)."
                                    },
                                    "rerunIncomplete": {
                                        "type": "boolean",
                                        "description": "Rerun jobs whose outputs are incomplete (--rerun-incomplete)."
                                    }
                                }
                            }
                        }
                    ],
                    "returns": "JSON object with the new run's runName and status, or an error.",
                    "readOnly": false
                }
            },
            {
                "command": "snakemake.positron.assistant.stopRun",
                "title": "Stop Pipeline Run (for the Assistant)",
                "category": "Snakemake",
                "agent": {
                    "description": "Stop a running Snakemake pipeline run. Snakemake cancels its running jobs, including Posit Workbench jobs, and exits.",
                    "args": [
                        {
                            "name": "runName",
                            "description": "Name of the run, as listRuns lists it. Defaults to the most recent run.",
                            "required": false,
                            "schema": {
                                "type": "string"
                            }
                        }
                    ],
                    "returns": "JSON object with the runName and stopping: true, or an error.",
                    "readOnly": false
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "snakemake",
                    "title": "Snakemake",
                    "icon": "media/snakemake.svg"
                }
            ]
        },
        "views": {
            "snakemake": [
                {
                    "id": "snakemake.runs",
                    "name": "Pipeline Runs",
                    "type": "tree",
                    "when": "isPositron"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "snakemake.runs",
                "contents": "No pipeline runs yet.\n[Run Pipeline](command:snakemake.positron.runs.run)\nSnakemake not found? [Show diagnostics](command:snakemake.positron.runs.diagnostics)."
            }
        ],
        "keybindings": [
            {
                "command": "snakemake.positron.runSelection",
                "key": "ctrl+enter",
                "mac": "cmd+enter",
                "when": "isPositron && editorTextFocus && editorLangId == snakemake"
            },
            {
                "command": "snakemake.positron.runBlock",
                "key": "ctrl+shift+enter",
                "mac": "cmd+shift+enter",
                "when": "isPositron && editorTextFocus && editorLangId == snakemake"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "snakemake.positron.runSelection",
                    "when": "isPositron && editorLangId == snakemake"
                },
                {
                    "command": "snakemake.positron.runBlock",
                    "when": "isPositron && editorLangId == snakemake"
                },
                {
                    "command": "snakemake.positron.openInDataExplorer",
                    "when": "isPositron && resourceFilename =~ /\\.(csv|tsv)$|^benchmark.*\\.txt$/i"
                },
                {
                    "command": "snakemake.positron.runs.runAgain",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.rerunIncomplete",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.finishJobs",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.openLog",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.remove",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.cancelJob",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.showJob",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.debugJob",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.openJobLog",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.copyJobId",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.runs.run",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.dryRun",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.stop",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.kill",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.unlock",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.showOutput",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.delete",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.deleteOutput",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.openReport",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.openDag",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.openRulegraph",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.openSummary",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.lint",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.showRunDashboard",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.refresh",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.runs.diagnostics",
                    "when": "isPositron"
                },
                {
                    "command": "snakemake.positron.assistant.listRuns",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.assistant.runStatus",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.assistant.launchPipeline",
                    "when": "false"
                },
                {
                    "command": "snakemake.positron.assistant.stopRun",
                    "when": "false"
                }
            ],
            "editor/context": [
                {
                    "command": "snakemake.positron.runSelection",
                    "when": "isPositron && editorLangId == snakemake",
                    "group": "navigation@0"
                },
                {
                    "command": "snakemake.positron.runBlock",
                    "when": "isPositron && editorLangId == snakemake",
                    "group": "navigation@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "snakemake.positron.openInDataExplorer",
                    "when": "isPositron && !explorerResourceIsFolder && resourceFilename =~ /\\.(csv|tsv)$|^benchmark.*\\.txt$/i",
                    "group": "navigation@20"
                }
            ],
            "editor/title/context": [
                {
                    "command": "snakemake.positron.openInDataExplorer",
                    "when": "isPositron && resourceFilename =~ /\\.(csv|tsv)$|^benchmark.*\\.txt$/i",
                    "group": "navigation@20"
                }
            ],
            "editor/title": [
                {
                    "command": "snakemake.positron.runs.run",
                    "when": "isPositron && resourceLangId == snakemake",
                    "group": "navigation@0"
                }
            ],
            "view/title": [
                {
                    "command": "snakemake.positron.runs.run",
                    "when": "view == snakemake.runs",
                    "group": "navigation@1"
                },
                {
                    "command": "snakemake.positron.runs.refresh",
                    "when": "view == snakemake.runs",
                    "group": "navigation@2"
                },
                {
                    "command": "snakemake.positron.runs.dryRun",
                    "when": "view == snakemake.runs",
                    "group": "more@0"
                },
                {
                    "command": "snakemake.positron.runs.unlock",
                    "when": "view == snakemake.runs",
                    "group": "more@1"
                },
                {
                    "command": "snakemake.positron.runs.diagnostics",
                    "when": "view == snakemake.runs",
                    "group": "more@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "snakemake.positron.runs.runAgain",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "inline@0"
                },
                {
                    "command": "snakemake.positron.runs.stop",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(queued|starting|running)$/",
                    "group": "inline@1"
                },
                {
                    "command": "snakemake.positron.runs.showOutput",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "inline@2"
                },
                {
                    "command": "snakemake.positron.runs.showRunDashboard",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "inline@3"
                },
                {
                    "command": "snakemake.positron.runs.delete",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "inline@9"
                },
                {
                    "command": "snakemake.positron.runs.stop",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(queued|starting|running)$/",
                    "group": "1_run@1"
                },
                {
                    "command": "snakemake.positron.runs.finishJobs",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.running$/",
                    "group": "1_run@2"
                },
                {
                    "command": "snakemake.positron.runs.kill",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(queued|starting|running)$/",
                    "group": "1_run@3"
                },
                {
                    "command": "snakemake.positron.runs.runAgain",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "1_run@4"
                },
                {
                    "command": "snakemake.positron.runs.rerunIncomplete",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "1_run@5"
                },
                {
                    "command": "snakemake.positron.runs.unlock",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "1_run@6"
                },
                {
                    "command": "snakemake.positron.runs.showRunDashboard",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "2_files@0"
                },
                {
                    "command": "snakemake.positron.runs.showOutput",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "2_files@1"
                },
                {
                    "command": "snakemake.positron.runs.openLog",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "2_files@2"
                },
                {
                    "command": "snakemake.positron.runs.openReport",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "2_reports@1"
                },
                {
                    "command": "snakemake.positron.runs.openRulegraph",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "2_reports@2"
                },
                {
                    "command": "snakemake.positron.runs.openDag",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "2_reports@3"
                },
                {
                    "command": "snakemake.positron.runs.openSummary",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\./",
                    "group": "2_reports@4"
                },
                {
                    "command": "snakemake.positron.runs.remove",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "3_manage@1"
                },
                {
                    "command": "snakemake.positron.runs.delete",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "3_manage@2"
                },
                {
                    "command": "snakemake.positron.runs.deleteOutput",
                    "when": "view == snakemake.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
                    "group": "3_manage@3"
                },
                {
                    "command": "snakemake.positron.runs.debugJob",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\..*\\+script/",
                    "group": "inline@0"
                },
                {
                    "command": "snakemake.positron.runs.cancelJob",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\.(submitted|queued|running)\\b.*\\+wb/",
                    "group": "inline@1"
                },
                {
                    "command": "snakemake.positron.runs.showJob",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\./",
                    "group": "1_job@0"
                },
                {
                    "command": "snakemake.positron.runs.debugJob",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\..*\\+script/",
                    "group": "1_job@1"
                },
                {
                    "command": "snakemake.positron.runs.openJobLog",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\..*\\+log/",
                    "group": "1_job@2"
                },
                {
                    "command": "snakemake.positron.runs.copyJobId",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\..*\\+wb/",
                    "group": "1_job@3"
                },
                {
                    "command": "snakemake.positron.runs.cancelJob",
                    "when": "view == snakemake.runs && viewItem =~ /^job\\.(submitted|queued|running)\\b.*\\+wb/",
                    "group": "2_manage@1"
                }
            ]
        },
        "languageModelTools": [
            {
                "name": "snakemake_listRuns",
                "displayName": "List Snakemake Runs",
