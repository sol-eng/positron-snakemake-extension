                "icon": "$(list-tree)",
                "userDescription": "List the Snakemake pipeline runs started in this workspace.",
                "modelDescription": "List the Snakemake pipeline runs started from Positron in this workspace, most recent first, with their status (queued, starting, running, succeeded, failed, stopped, lost), Snakefile, targets, start and end times, and job totals.",
                "tags": [
                    "positron-assistant",
                    "requires-workspace",
                    "snakemake"
                ],
                "inputSchema": {
                    "type": "object",
                    "properties": {}
                },
                "when": "isPositron"
            },
            {
                "name": "snakemake_runStatus",
                "displayName": "Snakemake Run Status",
                "toolReferenceName": "snakemakeRunStatus",
                "canBeReferencedInPrompt": true,
                "icon": "$(pulse)",
                "userDescription": "Show the status of a Snakemake run, including why jobs failed.",
                "modelDescription": "Get the detailed status of one Snakemake pipeline run: per-rule job counts, Snakemake's error messages, the jobs still running with their Workbench job ids, and every failed job with its rule, wildcards, shell command and the last lines of its log files. Use this to explain why a run failed.",
                "tags": [
                    "positron-assistant",
                    "requires-workspace",
                    "snakemake"
                ],
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "runName": {
                            "type": "string",
                            "description": "Name of the run, as listed by snakemake_listRuns. Defaults to the most recent run."
                        }
                    }
                },
                "when": "isPositron"
            },
            {
                "name": "snakemake_launchPipeline",
                "displayName": "Launch Snakemake Pipeline",
                "toolReferenceName": "snakemakeLaunch",
                "canBeReferencedInPrompt": true,
                "icon": "$(play)",
                "userDescription": "Start a Snakemake pipeline run, after confirmation.",
                "modelDescription": "Start a Snakemake pipeline run from Positron, which then appears in the Pipeline Runs view. The user confirms before it starts. Returns the new run's name; follow it with snakemake_runStatus.",
                "tags": [
                    "positron-assistant",
                    "requires-workspace",
                    "snakemake",
                    "requires-actions"
                ],
                "inputSchema": {
                    "type": "object",
                    "required": [
                        "snakefile"
                    ],
                    "properties": {
                        "snakefile": {
                            "type": "string",
                            "description": "Path of the workflow's Snakefile, absolute or relative to the workspace folder."
                        },
                        "targets": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Target rules or files to build. Defaults to the workflow's first rule."
                        },
                        "profile": {
