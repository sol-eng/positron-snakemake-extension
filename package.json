                                "type": [
                                    "string",
                                    "number",
                                    "boolean"
                                ]
                            },
                            "description": "Config overrides, as given with --config key=value."
                        },
                        "dryRun": {
                            "type": "boolean",
                            "description": "Only show what would be done (--dry-run)."
                        },
                        "rerunIncomplete": {
                            "type": "boolean",
                            "description": "Rerun jobs whose output is incomplete (--rerun-incomplete)."
                        }
                    }
                },
                "when": "isPositron"
            },
            {
                "name": "snakemake_stopRun",
                "displayName": "Stop Snakemake Run",
                "toolReferenceName": "snakemakeStop",
